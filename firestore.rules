rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function todayInTurkey() {
      let t = request.time + duration.value(3, 'h');
      return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month())
        + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }
    function todayStartMillis() {
      return (request.time + duration.value(3, 'h')).date().toMillis() - 10800000;
    }
    // Private, versioned Google account backup. No paid server required.
    function validPlayerSave() {
      let data = request.resource.data;
      let state = data.state;
      return data.keys().hasOnly(['version','revision','writeId','state','updatedAt'])
        && data.version == 1
        && data.revision is int && data.revision >= 1
        && data.writeId is string && data.writeId.size() > 0 && data.writeId.size() <= 100
        && data.updatedAt == request.time
        && state is map
        && state.keys().hasOnly(['stage','wallet','progress','records','streak'])
        && state.stage is int && state.stage >= 1 && state.stage <= 24
        && state.progress is map && state.progress.size() <= 24
        && state.records is list && state.records.size() <= 100
        && state.streak is map && state.streak.size() <= 4
        && state.wallet is map
        && state.wallet.keys().hasOnly(['gold','hints','claimed','migrated'])
        && state.wallet.gold is int && state.wallet.gold >= 0 && state.wallet.gold <= 1000000000
        && state.wallet.hints is int && state.wallet.hints >= 0 && state.wallet.hints <= 1000000
        && state.wallet.claimed is list && state.wallet.claimed.size() <= 24
        && state.wallet.migrated == true;
    }
    match /playerSaves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && validPlayerSave() && request.resource.data.revision == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && validPlayerSave() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    // Daily activity is derived from existing public wordScores; likes are
    // immutable and addressed by authenticated sender UID (one per day/player).
    match /communityLikes/{day}/players/{targetUid}/likes/{fromUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == fromUid
        && fromUid != targetUid
        && day == todayInTurkey()
        && request.resource.data.keys().hasOnly(['fromUid','toUid','day','scoreId','createdAt'])
        && request.resource.data.fromUid == fromUid
        && request.resource.data.toUid == targetUid
        && request.resource.data.day == day
        && request.resource.data.createdAt == request.time
        && request.resource.data.scoreId is string
        && request.resource.data.scoreId.matches('^[A-Za-z0-9_-]{1,150}$')
        && exists(/databases/$(database)/documents/wordScores/$(request.resource.data.scoreId))
        && get(/databases/$(database)/documents/wordScores/$(request.resource.data.scoreId)).data.uid == targetUid
        && get(/databases/$(database)/documents/wordScores/$(request.resource.data.scoreId)).data.mode == 'word'
        && get(/databases/$(database)/documents/wordScores/$(request.resource.data.scoreId)).data.date >= todayStartMillis()
        && get(/databases/$(database)/documents/wordScores/$(request.resource.data.scoreId)).data.date < todayStartMillis() + 86400000;
      allow update, delete: if false;
    }
    // Private device tokens; no client can read or register another user's token.
    match /users/{uid}/devices/{deviceId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt == request.time;
    }
    // Only the Admin SDK/Cloud Function creates inbox messages.
    match /userNotifications/{uid}/items/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }
    // New word-game leaderboard; old shooter scores remain separate.
    match /wordScores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'mode', 'date'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.mode == 'word'
        && request.resource.data.date is int;
      allow update, delete: if false;
    }
    match /scores/{score} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'mode', 'date'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.mode in ['classic', 'timed', 'daily', 'shooter']
        && request.resource.data.date is int;
      allow update, delete: if false;
    }
  }
}
